{
	"type": "object",
	"additionalProperties": false,
	"properties": {
		"concerns": {
			"type": "array",
			"maxItems": 100,
			"items": {
				"type": "object",
				"additionalProperties": false,
				"properties": {
					"area": {
						"type": "string"
					},
					"concern": {
						"type": "string"
					},
					"source_commit": {
						"type": "integer",
						"minimum": 1
					},
					"title": {
						"type": "string"
					},
					"question": {
						"type": "string"
					},
					"evidence": {
						"type": "string"
					},
					"doc_paths": {
						"type": "array",
						"minItems": 1,
						"items": {
							"type": "string"
						}
					},
					"placement": {
						"type": "object",
						"additionalProperties": false,
						"properties": {
							"examined_pages": {
								"type": "array",
								"minItems": 1,
								"items": {
									"type": "string"
								}
							},
							"canonical_pages": {
								"type": "array",
								"items": {
									"type": "string"
								}
							},
							"new_page_reason": {
								"type": "string"
							}
						},
						"required": ["examined_pages", "canonical_pages", "new_page_reason"]
					}
				},
				"required": [
					"area",
					"concern",
					"source_commit",
					"title",
					"question",
					"evidence",
					"doc_paths",
					"placement"
				]
			}
		},
		"inspected_commits": {
			"type": "array",
			"items": {
				"type": "integer",
				"minimum": 1
			}
		},
		"remaining_work": {
			"type": "string"
		},
		"release_audit_checks": {
			"type": "array",
			"items": {
				"type": "object",
				"additionalProperties": false,
				"properties": {
					"candidate_id": {
						"type": "string"
					},
					"status": {
						"type": "string",
						"enum": ["proposed", "covered", "not_applicable", "deferred"]
					},
					"concerns": {
						"type": "array",
						"items": {
							"type": "string"
						}
					},
					"evidence": {
						"type": "string"
					}
				},
				"required": ["candidate_id", "status", "concerns", "evidence"]
			}
		},
		"daily_commit_checks": {
			"type": "object",
			"properties": {},
			"additionalProperties": false,
			"required": []
		}
	},
	"required": [
		"concerns",
		"inspected_commits",
		"remaining_work",
		"release_audit_checks",
		"daily_commit_checks"
	],
	"definitions": {
		"daily_check": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"status": {
					"type": "string",
					"enum": ["proposed", "covered", "not_applicable", "blocked", "deferred"]
				},
				"concerns": {
					"type": "array",
					"items": {
						"type": "string"
					}
				},
				"evidence": {
					"type": "string"
				},
				"blockers": {
					"type": "array",
					"items": {
						"type": "object",
						"additionalProperties": false,
						"properties": {
							"pr": {
								"type": "integer",
								"minimum": 1
							},
							"path": {
								"type": "string"
							}
						},
						"required": ["pr", "path"]
					}
				}
			},
			"required": ["status", "concerns", "evidence", "blockers"]
		}
	}
}
